# Build-time variant: dev | preview | production. Unset local default: dev.
# EAS owns this value in eas.json; do not redefine it in EAS environments.
APP_VARIANT=dev

# Backend owner must supply an approved URL per environment.
# Optional for local tooling/development builds; required for EAS preview/production.
# Use an HTTPS origin without /api, credentials, query, fragment, or whitespace.
# Runtime removes the trailing slash; endpoint paths already include /api.
# EXPO_PUBLIC values are bundled into the app: never include secrets.
EXPO_PUBLIC_BASE_URL=

# Optional Android Firebase file path (local absolute/relative path or EAS file variable).
# Firebase owner must provide a file matching the approved Service Provider package.
# Without an override: dev prefers ./google-services.dev.json when present,
# otherwise the existing ./google-services.json reference is retained.
# GOOGLE_SERVICES_JSON=

# Guide 18: live notification hub URL, configured separately from the API origin.
# Absolute HTTPS URL including the hub path, e.g. https://<signalr-host>/hubs/notifications.
# Optional: when unset, live updates are off and screens refresh over HTTP only.
EXPO_PUBLIC_SIGNALR_URL=

# Guide 23: the HTTPS origin Stripe returns to (/billing?operationId=…), e.g. the web frontend.
# When set, Android App Links and iOS Universal Links open /billing in the app (native builds
# only, not Expo Go). The hosting team must publish /.well-known/assetlinks.json and
# /.well-known/apple-app-site-association on this origin for the app's package / bundle ID.
APP_LINK_ORIGIN=
